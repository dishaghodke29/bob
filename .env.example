# BOB Robot — Environment Configuration
# Save as /home/arduino/bob/.env
# These are loaded by main.py at startup

# ── Telegram Bot (for remote security alerts & control) ──────────────────────
# 1. Open Telegram → message @BotFather → /newbot → copy the token below
# 2. Message @userinfobot to get your chat ID
BOB_TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE
BOB_TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ── Smart Lights (optional — if you have Google Home / Tuya devices) ─────────
# Leave blank if not using
BOB_LIGHT_PLATFORM=
BOB_LIGHT_TOKEN=

# ── Serial port to MCU ────────────────────────────────────────────────────────
BOB_SERIAL_PORT=/dev/ttyHS1

# ── Web server ────────────────────────────────────────────────────────────────
BOB_WEB_PORT=8000
